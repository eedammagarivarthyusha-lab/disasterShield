# Browser-safe Supabase Project URL and publishable key (legacy anon key also works).
# Replace placeholders with the Project URL (Connect dialog) and publishable key (Settings → API Keys).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Never expose service-role or provider secrets as VITE_ variables.
# Server-only optional AI provider key (requires a trusted server/Edge Function):
OPENAI_API_KEY=
# Optional map tile URL template if replacing the OpenStreetMap standard tile service:
VITE_MAP_TILE_URL=
# Public weather uses Open-Meteo without a key; configure server proxy/cache before production scale.
